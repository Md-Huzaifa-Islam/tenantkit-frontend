# TenantKit frontend configuration. Copy to `.env`.

# Where the Next.js server forwards /api/v1/* and /uploads/*.
# Docker (default): the backend service on the shared `tenantkit-net` network.
# Local `pnpm dev`: http://localhost:4000
# NOTE: rewrites are baked in at build time, so rebuild the image after changing this.
API_INTERNAL_URL=http://api:4000

# Host port for the web app.
WEB_PORT=3000

# Playwright e2e target.
E2E_BASE_URL=http://localhost:3000
